#!/bin/sh
# Apply the existing native Home; release the presentation gate on integrity failure.
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
ROOT=/var/lib/lg-native
[ -d "$ROOT" ] || exit 0
if [ -e "$ROOT/home-disabled" ] || [ -L "$ROOT/home-disabled" ]; then
    "$ROOT/lg-native" gate disable >"$ROOT/home-boot.log" 2>&1
    exit 0
fi
rc=0
"$ROOT/lg-native" home apply --boot >"$ROOT/home-boot.log" 2>&1 || rc=$?
"$ROOT/lg-native" gate recover-if-unready >>"$ROOT/home-boot.log" 2>&1
exit "$rc"
